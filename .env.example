APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=eventos
POSTGRES_USER=eventos
POSTGRES_PASSWORD=eventos
SPRING_JPA_HIBERNATE_DDL_AUTO=update
KAFKA_PORT=29092
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
# Optional: initial ORGANIZADOR created on startup (only if the email does not exist yet).
# Leave email or password empty to skip it. Password: 8+ characters, at most 72 bytes.
# Do not reuse an example value: set your own password before starting.
ORGANIZADOR_NOMBRE=Organizador
ORGANIZADOR_EMAIL=organizador@example.com
ORGANIZADOR_PASSWORD=
